---
// The shared navbar, from src/partials/navbar.html (see src/lib/partials.ts).
import { renderPartial } from "../lib/partials.ts";

interface Props {
  /** The page's file name in the built site, e.g. "sem1.html" */
  page: string;
  /** The nav link to highlight, e.g. "architecture" */
  active?: string;
}
const { page, active } = Astro.props;
const html = await renderPartial("navbar", page, { active });
---

<Fragment set:html={html} />
