---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  page="404.html"
  title="Page not found"
  description="This page doesn't exist. Head back to the portfolio of Gaahis Yaugoob."
  styles={["404"]}
  bodyClass="home not-found"
  notFound
>
    <nav id="navbar" aria-label="Main">
        <div class="container">
            <a href="/folio/" class="nav-logo" aria-label="Gaahis Yaugoob, home">
                <span class="nav-mark" aria-hidden="true">GY</span>
                <span class="nav-name">Gaahis Yaugoob</span>
            </a>
        </div>
    </nav>

    <main class="nf">
        <div class="container nf__inner">
            <p class="eyebrow">Error 404</p>
            <h1 class="nf__title">Nothing was <em>drawn</em> here.</h1>
            <p class="nf__text">The page you’re looking for doesn’t exist, or it has moved. Everything else is still where you left it.</p>
            <div class="nf__actions">
                <a class="btn btn--primary" href="/folio/">Back to the portfolio</a>
                <a class="btn btn--ghost" href="/folio/#academic">See the work</a>
            </div>
        </div>
    </main>

    <footer class="site-footer">
        <div class="container site-footer__bottom">
            <p class="site-footer__copy">© <span id="currentYear"></span> Gaahis Yaugoob. All rights reserved.</p>
            <a class="site-footer__top" href="/folio/">Home</a>
        </div>
    </footer>

    <script src="/folio/assets/js/main.js" is:inline></script>
</BaseLayout>
