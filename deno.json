{
  "tasks": {
    "build": "deno run --allow-read=site,dist --allow-write=dist tools/build.ts",
    "dev": "deno run --allow-read=site,dist --allow-write=dist --allow-net tools/build.ts --watch --serve",
    "check": {
      "command": "deno run --allow-read=dist tools/check.ts",
      "dependencies": ["build"]
    }
  },
  "fmt": {
    "include": ["tools/"]
  },
  "lint": {
    "include": ["tools/"]
  }
}
