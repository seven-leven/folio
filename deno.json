{
  "nodeModulesDir": "auto",
  "tasks": {
    "dev": "deno run -A npm:vite",
    "build": "deno run -A npm:vite build",
    "preview": "deno run -A npm:vite preview"
  },
  "imports": {
    "vue": "npm:vue@^3.5.13",
    "vue-router": "npm:vue-router@^4.5.0",
    "vite": "npm:vite@^6.0.11",
    "@vitejs/plugin-vue": "npm:@vitejs/plugin-vue@^5.2.1",
    "@tailwindcss/vite": "npm:@tailwindcss/vite@^4.0.0",
    "tailwindcss": "npm:tailwindcss@^4.0.0"
  },
  "compilerOptions": {
    "lib": ["ES2020", "DOM", "DOM.Iterable", "deno.ns"],
    "jsx": "preserve",
    "types": ["vite/client"]
  }
}
