{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": ["tools/**/*.ts", "src/**/*.ts", "astro.config.ts", "public/assets/js/**/*.js"]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    }
  },
  "linter": {
    "rules": {
      "preset": "recommended",
      "style": {
        "useTemplate": "off",
        "noNonNullAssertion": "off",
        "useExponentiationOperator": "off"
      },
      "suspicious": {
        "useIterableCallbackReturn": "off",
        "noAssignInExpressions": "off",
        "noImplicitAnyLet": "off",
        "noRedundantUseStrict": "off"
      }
    }
  },
  "assist": {
    "enabled": false
  }
}
